---
/** Benefit 4, grows with you: ever bigger planets on a rising route. */
---

<svg class="benefit-art art-climb" viewBox="0 0 120 80" aria-hidden="true">
  <path class="route" d="M8 72 C 30 70 40 56 52 50 S 80 30 108 10" />
  <circle class="pl pl1" cx="22" cy="66" r="6" />
  <circle class="pl pl2" cx="54" cy="46" r="9" />
  <g class="pl pl3">
    <circle cx="92" cy="26" r="13" />
    <path class="pl-ring" d="M74 30q18-10 36-8" />
  </g>
  <g class="mini-rocket">
    <path class="r-hull" d="M7 0 C4 -4 0 -4 -5 -3 L-5 3 C0 4 4 4 7 0 Z" />
    <path class="r-flame" d="M-5 -2 C-9 -1 -10 0 -7 0 C-10 0 -9 1 -5 2 Z" />
    <animateMotion
      dur="5s"
      repeatCount="indefinite"
      rotate="auto"
      keyPoints="0;1;1"
      keyTimes="0;.8;1"
      calcMode="linear"
      path="M8 72 C 30 70 40 56 52 50 S 80 30 108 10"
    />
  </g>
</svg>
