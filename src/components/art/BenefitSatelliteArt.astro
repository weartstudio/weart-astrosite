---
/** Benefit 3, few plugins: one solid little satellite. */
---

<svg class="benefit-art art-sat" viewBox="0 0 120 80" aria-hidden="true">
  <g class="sat">
    <g class="panel panel-l">
      <rect x="10" y="30" width="30" height="18" rx="2" />
      <path d="M20 30v18M30 30v18M10 39h30" />
    </g>
    <g class="panel panel-r">
      <rect x="80" y="30" width="30" height="18" rx="2" />
      <path d="M90 30v18M100 30v18M80 39h30" />
    </g>
    <path class="arm" d="M40 39h8M72 39h8" />
    <rect class="core" x="48" y="26" width="24" height="26" rx="4" />
    <circle class="core-win" cx="60" cy="36" r="4.5" />
    <path class="dish" d="M54 26q6-12 12 0" />
    <path class="ant" d="M60 18v-8" />
    <circle class="ant-tip" cx="60" cy="9" r="2.4" />
  </g>
  <path class="ok" d="M86 62l5 5 9-10" />
</svg>
