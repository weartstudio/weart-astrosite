    <circle class="pl-body" cx="44" cy="400" r="62" />
    <path class="pl-band" d="M-8 366q52-14 104 0M-14 386q58 10 116-2" />
    <circle class="pl-crater" cx="70" cy="364" r="7" />
    <g transform="rotate(-16 44 400)">
      <path class="pl-ring" d="M148 400a104 22 0 0 1 -208 0" />
    </g>
  </g>
  <g class="ts-moon">
    <circle class="mn" cx="366" cy="214" r="12" />
    <circle class="mc" cx="362" cy="210" r="3" />
    <circle class="mc" cx="371" cy="219" r="2" />
  </g>
  <g class="ts-rocket" transform="translate(352 26) rotate(-24) scale(1)">
    <g class="svc-rocket-in">
      <path class="r-trail" d="M-14 -6 C-24 -8 -36 -4 -46 3 C-36 2 -24 4 -14 6 Z" />
      <path class="r-flame" d="M-12 -5 C-22 -4 -28 0 -20 0 C-28 0 -22 4 -12 5 Z" />
      <path class="r-fin" d="M-6 -9 L-17 -20 C-19 -14 -17 -10 -12 -7 Z" />
      <path class="r-fin" d="M-6 9 L-17 20 C-19 14 -17 10 -12 7 Z" />
      <path class="r-hull" d="M30 0 C23 -11 9 -14 -12 -10 L-12 10 C9 14 23 11 30 0 Z" />
      <path class="r-nose" d="M30 0 C26 -6 22 -8 18 -9 L18 9 C22 8 26 6 30 0 Z" />
      <circle class="r-window" cx="5" cy="0" r="4.6" />
    </g>
  </g>
</svg>
