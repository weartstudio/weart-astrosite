---
/** About section backdrop: stars, a ringed planet rising bottom-left, a moon and a small rocket. */
---

<svg class="team-space" viewBox="0 0 400 390" preserveAspectRatio="xMidYMid slice">
  <g class="ts-stars">
    <circle cx="262" cy="96" r="1.6" />
    <circle cx="388" cy="64" r="1.2" />
    <circle cx="214" cy="226" r="1.4" />
    <circle cx="300" cy="246" r="1.1" />
    <circle cx="24" cy="226" r="1.3" />
    <circle cx="160" cy="276" r="1.6" />
    <circle cx="372" cy="150" r="1.4" />
    <circle cx="246" cy="14" r="1.2" />
    <circle cx="196" cy="372" r="1.3" />
    <circle cx="102" cy="226" r="1" />
    <circle cx="234" cy="304" r="1.2" />
  </g>
  <path class="sp" d="M262 184q1.6 9 11 11q-9.4 1.6-11 11q-1.6-9.4-11-11q9.4-1.6 11-11z" />
  <path class="sp sp--2" d="M58 192q1.2 6.4 8 8q-6.8 1.2-8 8q-1.2-6.8-8-8q6.8-1.2 8-8z" />
  <path class="sp sp--2" d="M214 340q1.1 6 7 7q-6 1.1-7 7q-1.1-6-7-7q6-1.1 7-7z" />
