---
import { faq } from '../../data/faq';
import SparksDoodle from '../icons/SparksDoodle.astro';
---

<section class="section section-raised" id="gyik" aria-labelledby="gyik-title">
  <div class="container faq-grid">
    <header class="section-head reveal has-doodle">
      <SparksDoodle class="doodle--faq" />
      <p class="eyebrow eyebrow-light">gyakori kérdések</p>
      <h2 id="gyik-title">Amit mindenki megkérdez az elején</h2>
      <p>Nem találod a választ? Írj nyugodtan, nem kötelez semmire.</p>
    </header>

    <div class="faq reveal">
      {faq.map(({ question, answer }) => (
        <details>
          <summary>{question}</summary>
          <div class="faq-body">
            <p>{answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <script>
    import { $, $$, prefersReducedMotion } from '../../scripts/dom';

    // one open at a time, animated height
    const items = $$<HTMLDetailsElement>('.faq details');

    function open(item: HTMLDetailsElement): void {
      const body = $('.faq-body', item);
      item.open = true;
      if (!body || prefersReducedMotion()) return;
      const height = body.scrollHeight;
      body.style.height = '0px';
      requestAnimationFrame(() => (body.style.height = `${height}px`));
      body.addEventListener('transitionend', () => (body.style.height = ''), { once: true });
    }

    function close(item: HTMLDetailsElement): void {
      const body = $('.faq-body', item);
      if (!body || prefersReducedMotion()) {
        item.open = false;
        return;
      }
      body.style.height = `${body.scrollHeight}px`;
      requestAnimationFrame(() => (body.style.height = '0px'));
      body.addEventListener(
        'transitionend',
        () => {
          item.open = false;
          body.style.height = '';
        },
        { once: true },
      );
    }

    for (const item of items) {
      $('summary', item)?.addEventListener('click', (e) => {
        e.preventDefault();
        if (item.open) {
          close(item);
          return;
        }
        items.filter((other) => other !== item && other.open).forEach(close);
        open(item);
      });
    }
  </script>
</section>
