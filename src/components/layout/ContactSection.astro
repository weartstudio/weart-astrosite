---
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import { site } from '../../data/site';
import { getGravityForm } from '../../lib/wordpress/gravity-forms';

// fields, labels and button come from Gravity Forms at build time; the browser posts straight to its REST API
const form = await getGravityForm(site.contactFormId);
const inputTypes = { text: 'text', email: 'email', phone: 'tel', website: 'url', number: 'number' } as const;
const domId = (fieldId: number) => `gf-${form.id}-${fieldId}`;
---

<section class="section section-dark contact" id="kapcsolat" aria-labelledby="kapcsolat-title">
  <svg class="space space--contact" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <g class="stars"></g>
    <g class="shooting">
      <path d="M0 0 L-140 -46"></path>
    </g>
    <g class="planet planet--small">
      <g transform="rotate(18 1300 120)">
        <path class="planet-ring planet-ring--back" d="M1150 120 a150 36 0 0 1 300 0"></path>
      </g>
      <circle cx="1300" cy="120" r="80" fill="url(#planet-fill)"></circle>
      <circle class="crater" cx="1272" cy="96" r="10"></circle>
      <circle class="crater" cx="1326" cy="140" r="6"></circle>
      <g transform="rotate(18 1300 120)">
        <path class="planet-ring" d="M1450 120 a150 36 0 0 1 -300 0"></path>
      </g>
    </g>
    <circle class="moon-dot" cx="1120" cy="250" r="9"></circle>
  </svg>
  <div class="container contact-grid">
    <div class="contact-copy">
      <p class="eyebrow eyebrow-dark reveal">beszélgessünk</p>
      <h2 id="kapcsolat-title" class="reveal">
        Mesélj a projektedről!
      </h2>
      <p class="reveal">
        Köszönjük, hogy időt szánsz ránk! Küldj pár sort a projektedről, hogy lássuk, hogyan tudunk a legtöbbet
        segíteni. Gyorsan és személyesen válaszolunk.
      </p>

      <ul class="contact-direct reveal">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"></path>
          </svg>
          <a href={site.phone.href}>{site.phone.label}</a>
        </li>
      </ul>
      <div class="contact-person reveal">
        <PhotoPlaceholder class="placeholder--round contact-avatar" caption="Fanni<br>képe" />
        <p>
          <strong>Ágoston Fanni</strong>
          <span>A megkereséseket ő kezeli: egy állandó kapcsolattartód lesz az első üzenettől az átadásig.</span>
        </p>
      </div>
    </div>

    <form
      class="contact-form reveal"
      id="contact-form"
      action={form.submitUrl}
      method="post"
      novalidate
      data-success={form.successMessage}
      data-version-hash={form.honeypot?.versionHash}
    >
      <div class="form-grid">
        {form.fields.map((field) => {
          if (field.type === 'hidden') return <input type="hidden" name={field.name} value={field.defaultValue} />;
          const id = domId(field.id);
          const descId = field.description ? `${id}-desc` : undefined;
          const common = {
            id,
            name: field.name,
            required: field.required,
            'aria-describedby': descId,
          };
          return (
            <div
              class:list={['field', { 'field--half': field.half }]}
              data-logic={field.logic && JSON.stringify(field.logic)}
              hidden={field.logic ? true : undefined}
            >
              <label for={id}>
                {field.label}
                {field.required && '*'}
              </label>
              {field.type === 'select' ? (
                <select {...common}>
                  {field.choices.map(({ text, value, selected }) => (
                    <option value={value} selected={selected}>
                      {text}
                    </option>
                  ))}
                </select>
              ) : field.type === 'textarea' ? (
                <textarea
                  {...common}
                  rows="4"
                  placeholder={field.placeholder || undefined}
                  maxlength={field.maxLength}
                  set:text={field.defaultValue}
                />
              ) : (
                <input
                  {...common}
                  type={inputTypes[field.type]}
                  value={field.defaultValue || undefined}
                  placeholder={field.placeholder || undefined}
                  maxlength={field.maxLength}
                  autocomplete={field.autocomplete}
                />
              )}
              {field.description && (
                <span class="field-desc" id={descId}>
                  {field.description}
                </span>
              )}
            </div>
          );
        })}
      </div>
      {form.honeypot && (
        <div class="sr-only" aria-hidden="true">
          <label for={`gf-${form.id}-hp`}>Ezt a mezőt hagyd üresen</label>
          <input id={`gf-${form.id}-hp`} name={form.honeypot.name} type="text" tabindex="-1" autocomplete="off" />
        </div>
      )}
      <button class="btn btn-primary btn-block" type="submit">
        {form.submitLabel}
      </button>
      <p class="form-status" role="status" aria-live="polite"></p>
      <p class="form-hint">Az üzenetküldés nem kötelez semmire.</p>
    </form>
  </div>
  <script>
    import '../../scripts/starfield';
    import { site } from '../../data/site';
    import { $, $$ } from '../../scripts/dom';
    import type { FieldLogic } from '../../lib/wordpress/gravity-forms';

    type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    interface SubmissionResult {
      is_valid?: boolean;
      validation_messages?: Record<string, string>;
    }

    const messages = {
      valueMissing: 'Ezt a mezőt kérlek, töltsd ki.',
      email: 'Kérlek, valós e-mail címet adj meg.',
      url: 'Kérlek, valós webcímet adj meg.',
      sending: 'Küldés…',
      failed: `Nem sikerült elküldeni az üzenetet. Kérlek, próbáld újra, vagy írj nekünk: ${site.email}`,
    };

    const form = $<HTMLFormElement>('#contact-form');
    const status = form && $('.form-status', form);
    const submit = form && $<HTMLButtonElement>('button[type="submit"]', form);

    const controls = () => (form ? $$<Control>('.field input, .field select, .field textarea', form) : []);
    const controlFor = (fieldId: string) => form?.querySelector<Control>(`.field [name="input_${fieldId}"]`) ?? null;

    function setError(control: Control, message: string | null) {
      const field = control.closest('.field');
      if (!field) return;
      $('.error-msg', field)?.remove();
      field.classList.toggle('has-error', message !== null);
      const descId = $('.field-desc', field)?.id;
      if (message === null) {
        control.removeAttribute('aria-invalid');
        if (descId) control.setAttribute('aria-describedby', descId);
        else control.removeAttribute('aria-describedby');
        return;
      }
      const msg = document.createElement('span');
      msg.className = 'error-msg';
      msg.id = `${control.id}-err`;
      msg.textContent = message;
      field.appendChild(msg);
      control.setAttribute('aria-invalid', 'true');
      control.setAttribute('aria-describedby', descId ? `${descId} ${msg.id}` : msg.id);
    }

    // Gravity Forms conditional logic: hidden fields are disabled, so they are neither validated nor sent
    const conditional = form ? $$<HTMLElement>('.field[data-logic]', form) : [];
    function applyLogic() {
      const matches = ({ fieldId, operator, value }: FieldLogic['rules'][number]) => {
        const current = controlFor(fieldId)?.disabled ? '' : (controlFor(fieldId)?.value ?? '');
        switch (operator) {
          case 'is':
            return current === value;
          case 'isnot':
            return current !== value;
          case 'contains':
            return current.includes(value);
          case 'starts_with':
            return current.startsWith(value);
          case 'ends_with':
            return current.endsWith(value);
          default:
            return false;
        }
      };
      for (const field of conditional) {
        const logic = JSON.parse(field.dataset.logic ?? '{}') as FieldLogic;
        const met = logic.logicType === 'any' ? logic.rules.some(matches) : logic.rules.every(matches);
        const show = logic.actionType === 'hide' ? !met : met;
        field.hidden = !show;
        $$<Control>('input, select, textarea', field).forEach((control) => (control.disabled = !show));
      }
    }
    if (conditional.length) {
      applyLogic();
      form?.addEventListener('input', applyLogic);
      form?.addEventListener('change', applyLogic);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      let firstInvalid: Control | null = null;
      for (const control of controls()) {
        if (control.checkValidity()) {
          setError(control, null);
          continue;
        }
        const mismatch = control.validity.typeMismatch && (control.type === 'url' ? messages.url : messages.email);
        setError(control, mismatch || messages.valueMissing);
        firstInvalid ??= control;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        if (status) status.textContent = '';
        return;
      }

      if (submit) submit.disabled = true;
      if (status) status.textContent = messages.sending;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), version_hash: form.dataset.versionHash }),
        });
        const result = (await response.json()) as SubmissionResult;

        if (result.is_valid) {
          form.reset();
          applyLogic();
          if (status) status.textContent = form.dataset.success ?? '';
          return;
        }
        // server side validation: show Gravity Forms' messages next to the fields
        const invalid = Object.entries(result.validation_messages ?? {}).flatMap(([fieldId, message]) => {
          const control = controlFor(fieldId);
          if (control) setError(control, message);
          return control ? [control] : [];
        });
        if (!invalid.length) throw new Error(`Gravity Forms: ${response.status}`);
        invalid[0]?.focus();
        if (status) status.textContent = '';
      } catch {
        if (status) status.textContent = messages.failed;
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</section>
