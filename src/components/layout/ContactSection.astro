---
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import { site } from '../../data/site';

const topics = ['Új weboldal', 'Webshop', 'Meglévő oldal fejlesztése', 'Karbantartás, támogatás', 'Még nem tudom'];
---

<section class="section section-dark contact" id="kapcsolat" aria-labelledby="kapcsolat-title">
  <svg class="space space--contact" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <g class="stars"></g>
    <g class="shooting">
      <path d="M0 0 L-140 -46"></path>
    </g>
    <g class="planet planet--small">
      <g transform="rotate(18 1300 120)">
        <path class="planet-ring planet-ring--back" d="M1150 120 a150 36 0 0 1 300 0"></path>
      </g>
      <circle cx="1300" cy="120" r="80" fill="url(#planet-fill)"></circle>
      <circle class="crater" cx="1272" cy="96" r="10"></circle>
      <circle class="crater" cx="1326" cy="140" r="6"></circle>
      <g transform="rotate(18 1300 120)">
        <path class="planet-ring" d="M1450 120 a150 36 0 0 1 -300 0"></path>
      </g>
    </g>
    <circle class="moon-dot" cx="1120" cy="250" r="9"></circle>
  </svg>
  <div class="container contact-grid">
    <div class="contact-copy">
      <p class="eyebrow eyebrow-dark reveal">beszélgessünk</p>
      <h2 id="kapcsolat-title" class="reveal">
        Mesélj a projektedről!
      </h2>
      <p class="reveal">
        Köszönjük, hogy időt szánsz ránk! Küldj pár sort a projektedről, hogy lássuk, hogyan tudunk a legtöbbet
        segíteni. Gyorsan és személyesen válaszolunk.
      </p>

      <ul class="contact-direct reveal">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"></path>
          </svg>
          <a href={site.phone.href}>{site.phone.label}</a>
        </li>
      </ul>
      <div class="contact-person reveal">
        <PhotoPlaceholder class="placeholder--round contact-avatar" caption="Fanni<br>képe" />
        <p>
          <strong>Ágoston Fanni</strong>
          <span>A megkereséseket ő kezeli: egy állandó kapcsolattartód lesz az első üzenettől az átadásig.</span>
        </p>
      </div>
    </div>

    <form class="contact-form reveal" id="contact-form" novalidate>
      <div class="field">
        <label for="f-name">Név*</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="f-email">E-mail*</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-phone">Telefonszám*</label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
      </div>
      <div class="field">
        <label for="f-type">Miben segíthetünk?</label>
        <select id="f-type" name="type">
          {topics.map((topic) => (
            <option>{topic}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="f-msg">Üzenet*</label>
        <textarea
          id="f-msg"
          name="message"
          rows="4"
          required
          placeholder="Pár mondat a projektedről és arról, mit szeretnél elérni."
        ></textarea>
      </div>
      <button class="btn btn-primary btn-block" type="submit">
        Üzenet küldése
      </button>
      <p class="form-status" role="status" aria-live="polite"></p>
      <p class="form-hint">Az üzenetküldés nem kötelez semmire.</p>
    </form>
  </div>
  <script>
    import '../../scripts/starfield';
    import { $, $$ } from '../../scripts/dom';

    // No backend yet: a valid submission opens a prefilled e-mail in the visitor's mail client.
    // Swap this for Gravity Forms or a real endpoint on the live site.
    const RECIPIENT = 'info@weart.hu';
    const messages = {
      valueMissing: 'Ezt a mezőt kérlek, töltsd ki.',
      typeMismatch: 'Kérlek, valós e-mail címet adj meg.',
    };

    const form = $<HTMLFormElement>('#contact-form');
    const status = form && $('.form-status', form);

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;

      for (const input of $$<HTMLInputElement | HTMLTextAreaElement>('input, textarea', form)) {
        const field = input.closest('.field');
        if (!field) continue;
        $('.error-msg', field)?.remove();
        field.classList.remove('has-error');
        input.removeAttribute('aria-invalid');
        if (input.checkValidity()) continue;

        const msg = document.createElement('span');
        msg.className = 'error-msg';
        msg.id = `${input.id}-err`;
        msg.textContent = input.validity.typeMismatch ? messages.typeMismatch : messages.valueMissing;
        field.appendChild(msg);
        field.classList.add('has-error');
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', msg.id);
        firstInvalid ??= input;
      }

      if (firstInvalid) {
        firstInvalid.focus();
        if (status) status.textContent = '';
        return;
      }

      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '');
      const subject = `Ajánlatkérés: ${value('type')}, ${value('name')}`;
      const body = [
        `Név: ${value('name')}`,
        `E-mail: ${value('email')}`,
        `Telefon: ${value('phone')}`,
        `Téma: ${value('type')}`,
        '',
        value('message'),
      ].join('\n');
      window.location.href = `mailto:${RECIPIENT}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (status)
        status.textContent = 'Megnyitottuk a levelezőprogramodat az előre kitöltött üzenettel, csak küldd el!';
    });
  </script>
</section>
